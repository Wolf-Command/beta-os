<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wolf.mac-reachability.heartbeat</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/wolfterminal/beta-os/scripts/mac-reachability/heartbeat.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/wolfterminal/beta-os</string>
