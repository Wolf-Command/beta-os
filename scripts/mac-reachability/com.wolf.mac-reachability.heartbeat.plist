<!--
  TEMPLATE ONLY — NOT INSTALLED.
  When Mac GREEN: copy to ~/Library/LaunchAgents/com.wolf.mac-reachability.heartbeat.plist
  then: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.wolf.mac-reachability.heartbeat.plist

