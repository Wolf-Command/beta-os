# beta-os Content Engine — LLM API keys (paste real values into .env)
# NEVER commit real keys. Restart serve_beta after editing .env.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY=   # alternate for Gemini if GEMINI_API_KEY unset

# Smoke without spending: set to 1 for fake responses + sqlite logging
BETA_LLM_DRY_RUN=0

# --- Authentication (Wolf Core real auth binding) ---
# Normal Beta default when unset = cloudflare_access (fail-closed, incl. local :8788).
# development_assertion ONLY if explicitly set (local automated tests / Content Machine without CF).
# BETA_AUTH_MODE=cloudflare_access
# BETA_AUTH_MODE=development_assertion
#
# Team domain (JWKS at {domain}/cdn-cgi/access/certs)
BETA_CF_ACCESS_TEAM_DOMAIN=https://wolfcommand.cloudflareaccess.com
#
# Application Audience (AUD) Tag — REQUIRED in cloudflare_access mode.
# Copy from Cloudflare Zero Trust → Access → Applications → beta.wolfcommand.net
# → Application Audience (AUD) Tag. Never commit the real value to git.
BETA_CF_ACCESS_AUD=


# Metricool — FAIL CLOSED defaults (Beta isolation)
# Do NOT point BETA_METRICOOL_CREDS_PATH at ~/.openclaw or wolf-system.
BETA_METRICOOL_ENABLED=false
BETA_METRICOOL_WRITE_ENABLED=false
# BETA_METRICOOL_CREDS_PATH=private/metricool.local.json
